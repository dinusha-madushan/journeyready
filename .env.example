# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Geoapify (free key): https://www.geoapify.com
# Used for nearby places and routes. Server only. Never expose it in the browser.
GEOAPIFY_API_KEY=
